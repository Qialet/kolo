// use prisma-8

enum FleetStatus {
  @@type("pg/text@1")
  ON_LINE     = "ON_LINE"
  IN_PARK     = "IN_PARK"
  MAINTENANCE = "MAINTENANCE"
}

enum OrderStatus {
  @@type("pg/text@1")
  SEARCHING   = "SEARCHING"
  ASSIGNED    = "ASSIGNED"
  ARRIVED     = "ARRIVED"
  IN_PROGRESS = "IN_PROGRESS"
  COMPLETED   = "COMPLETED"
  CANCELLED   = "CANCELLED"
  NO_SHOW     = "NO_SHOW"
  EXPIRED     = "EXPIRED"
}

enum OrderEventType {
  @@type("pg/text@1")
  CREATED          = "CREATED"
  OFFERED          = "OFFERED"
  OFFER_MISSED     = "OFFER_MISSED"
  ASSIGNED         = "ASSIGNED"
  ARRIVED          = "ARRIVED"
  PICKED_UP        = "PICKED_UP"
  COMPLETED        = "COMPLETED"
  CANCELLED        = "CANCELLED"
  NO_SHOW          = "NO_SHOW"
  EXPIRED          = "EXPIRED"
  DISPUTE_OPENED   = "DISPUTE_OPENED"
  DISPUTE_RESOLVED = "DISPUTE_RESOLVED"
}

enum Actor {
  @@type("pg/text@1")
  PASSENGER  = "PASSENGER"
  DRIVER     = "DRIVER"
  DISPATCHER = "DISPATCHER"
  SYSTEM     = "SYSTEM"
}

enum OrderSource {
  @@type("pg/text@1")
  APP        = "APP"
  PHONE      = "PHONE"
  BUS_STOP   = "BUS_STOP"
  DISPATCHER = "DISPATCHER"
}

enum DisputeStatus {
  @@type("pg/text@1")
  OPEN     = "OPEN"
  REFUNDED = "REFUNDED"
  REJECTED = "REJECTED"
}

/// Fleet partner company operating one or more depots for the aggregator.
model Partner {
  id        String            @id
  name      String
  color     String
  parks     Park[]
  createdAt TimestamptzString @default(now())
}

/// Taxi depot; `id` matches the depot id generated by @kolo/sim (P1, P2, …).
model Park {
  id           String  @id
  name         String
  address      String
  capacity     Int
  serviceBoxes Int
  partnerId    String
  partner      Partner @relation(fields: [partnerId], references: [id])
  vehicles     Vehicle[]
  drivers      Driver[]

  @@index([partnerId])
}

model Driver {
  id        String            @id
  name      String
  phone     String
  rating    Float
  licenseNo String            @unique
  parkId    String
  park      Park              @relation(fields: [parkId], references: [id])
  vehicle   Vehicle?
  createdAt TimestamptzString @default(now())

  @@index([parkId])
}

model Vehicle {
  id            String                 @id
  plate         String                 @unique
  model         String
  color         String
  year          Int
  mileageKm     Int
  fleetStatus   FleetStatus
  parkId        String
  park          Park                   @relation(fields: [parkId], references: [id])
  driverId      String?                @unique
  driver        Driver?                @relation(fields: [driverId], references: [id])
  orders        Order[]
  statusChanges VehicleStatusChange[]
  updatedAt     temporal.updatedAtString()

  @@index([parkId])
  @@index([fleetStatus])
}

/// Audit trail of fleet status changes (who switched a car on line, to park, to service).
model VehicleStatusChange {
  id        Int               @id @default(autoincrement())
  vehicleId String
  vehicle   Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  status    FleetStatus
  actor     Actor
  at        TimestamptzString @default(now())

  @@index([vehicleId])
}

/// Ride order; `id` is generated by the simulation so live and stored orders share ids.
model Order {
  id             String            @id
  code           String            @unique
  status         OrderStatus
  source         OrderSource
  passengerName  String
  pickupId       String
  pickupLabel    String
  pickupX        Float
  pickupZ        Float
  dropoffId      String
  dropoffLabel   String
  dropoffX       Float
  dropoffZ       Float
  vehicleId      String?
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id])
  fareRsd        Int
  distanceMeters Int
  cancelReason   String?
  events         OrderEvent[]
  disputes       Dispute[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([status])
  @@index([vehicleId])
  @@index([createdAt])
}

model OrderEvent {
  id        Int               @id @default(autoincrement())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  actor     Actor
  note      String?
  vehicleId String?
  x         Float?
  z         Float?
  at        TimestamptzString @default(now())

  @@index([orderId])
}

/// Passenger objection to a finished order (overcharge, route, rudeness …).
model Dispute {
  id         String             @id @default(uuid())
  orderId    String
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason     String
  status     DisputeStatus
  note       String?
  openedAt   TimestamptzString  @default(now())
  resolvedAt TimestamptzString?

  @@index([orderId])
  @@index([status])
}
